}{
	"Guid": 102,
	"Type": "Material"
}##Vertex

VertexInput {
    vec2 aPos : Position
    vec2 texCoord : TexCoord0
    vec4 color : Color
}

uniform mat3 objectToWorld;
uniform mat3 worldToView;
uniform mat3 viewToScreen;

out vec4 vertexColor;
out vec2 uv;

void main()
{
    gl_Position = vec4(aPos.x * 2.0, aPos.y * 2.0, 0.0, 1.0);
    uv = texCoord;
    vertexColor = color;
}

##Fragment

in vec4 vertexColor;
in vec2 uv;

out vec4 FragColor;

uniform sampler2D mainTex;
uniform float time;
vec4 tint;

void main()
{
    tint = vec4(1.0, 1.0, 1.0, 1.0);
    float brightness = 0.5 + 0.5 * sin(time);
    FragColor = texture(mainTex, uv) * tint * brightness;
}{
    "Guid": 200,
	"Type": "Shader"
}
